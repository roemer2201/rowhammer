.claude/
# Package build artifacts: the output directory shared by build-deb.sh and
# build-rpm.sh (the latter also keeps its private rpmbuild tree in there)
# plus the dpkg-buildpackage / debhelper litter.
dist/
debian/rowhammer/
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/*.log

# Demo-clip toolchain intermediates (tools/demo/make_demos.py)
tools/demo/.build/

# Python bytecode caches
__pycache__/
*.pyc
